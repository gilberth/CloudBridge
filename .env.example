# ---------------------------------------------------------------------------
# CloudBridge — copy to `.env` and fill in before `docker compose up -d`.
# ---------------------------------------------------------------------------

# Host port the web UI is published on. Put Traefik / Cloudflare Tunnel in
# front of this; the container itself speaks plain HTTP on 3000.
CLOUDBRIDGE_PORT=8080

# --- rclone rc daemon ------------------------------------------------------
# Credentials for the rclone rc API. The daemon is only reachable from the
# internal Docker network, but authentication stays mandatory: access to the
# rc API is equivalent to shell access as the user running rclone.
# Generate with: openssl rand -hex 16
RCLONE_RC_USER=cloudbridge
RCLONE_RC_PASS=change-me-rclone-password
RCLONE_LOG_LEVEL=INFO

# --- Sessions --------------------------------------------------------------
# Signing key for the session cookie. Generate with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-64-character-hex-string-generated-with-openssl-rand
# How long a login stays valid.
SESSION_TTL_HOURS=12
# Set to true when serving over HTTPS (Traefik / Cloudflare Tunnel do this).
COOKIE_SECURE=false
# Needed so rate limiting sees the real client IP behind a reverse proxy.
TRUST_PROXY=true

# --- First administrator ---------------------------------------------------
# Seeded on first boot only; changing it later does not rewrite the password.
ADMIN_USER=admin
ADMIN_PASSWORD=change-me-at-least-8-chars

# --- Misc ------------------------------------------------------------------
LOG_LEVEL=info
# Scheduler timezone default; can also be changed later in Settings.
TZ=UTC
