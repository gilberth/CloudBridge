{
  "name": "cloudbridge",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.21.0",
  "description": "Self-hosted multi-cloud manager powered by the rclone RC API",
  "license": "MIT",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "build": "pnpm --filter @cloudbridge/shared build && pnpm --filter @cloudbridge/api build && pnpm --filter @cloudbridge/web build",
    "build:shared": "pnpm --filter @cloudbridge/shared build",
    "dev": "pnpm run build:shared && concurrently -n api,web -c cyan,magenta \"pnpm run dev:api\" \"pnpm run dev:web\"",
    "dev:api": "pnpm --filter @cloudbridge/api dev",
    "dev:web": "pnpm --filter @cloudbridge/web dev",
    "typecheck": "pnpm -r --if-present run typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm --filter @cloudbridge/api test",
    "test:e2e": "pnpm --filter @cloudbridge/web test:e2e",
    "db:generate": "pnpm --filter @cloudbridge/api db:generate",
    "db:migrate": "pnpm --filter @cloudbridge/api db:migrate",
    "seed": "pnpm --filter @cloudbridge/api seed"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "concurrently": "^9.1.2",
    "eslint": "^10.9.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.11.0",
    "prettier": "^3.9.6",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.67.0"
  }
}
